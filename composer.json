{
    "name": "hryvinskyi/magento2-cart-progress-bar",
    "description": "Cart progress bar: shows the shopper how far the cart is from a spend goal that other modules contribute, at the top of the header, in the minicart and on the cart page.",
    "type": "magento2-module",
    "version": "1.2.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "hryvinskyi/magento2-theme-assets": "^1.0.1",
        "magento/framework": "*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-checkout": "*",
        "magento/module-config": "*",
        "magento/module-customer": "*",
        "magento/module-store": "*",
        "magento/module-ui": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\CartProgressBar\\": ""
        }
    }
}
