declare(strict_types=1);

use Hryvinskyi\CartProgressBar\ViewModel\BarConfig;

/**
 * The bar's configuration, once per page, read by every placement: the store's goals and price format. The page is
 * full-page cached, so the block holds nothing about the visitor. Prints nothing where the bar does not show.
 *
 * Block argument: view_model (the bar's view model).
 *
 * @var \Magento\Framework\View\Element\Template $block
 */

$barConfig = $block->getData('view_model');
if (!$barConfig instanceof BarConfig || !$barConfig->isEnabled()) {
    return;
}
?>
<script type="application/json" data-role="cart-progress-bar-config"><?= /* @noEscape */ $barConfig->configJson() ?></script>
